{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDatabase": "Host=localhost;Port=5433;Database=smartpalm_identity;Username=smartpalm_identity;Password=change-me"
  },
  "Jwt": {
    "Issuer": "smartpalm.identity",
    "Audience": "smartpalm.clients",
    "Key": "replace-with-a-secure-key",
    "ExpirationMinutes": 10080
  },
  "RabbitMq": {
    "Enabled": false,
    "Uri": "amqp://guest:guest@localhost:5672/",
    "Exchange": "smartpalm.events"
  },
  "Seed": {
    "Enabled": false
  }
}
